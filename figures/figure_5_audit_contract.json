{
  "schema_version": "eog_structural_figure5_audit_v1",
  "purpose": "Expose the frozen evidence-to-result chain for the structural manuscript without introducing a new ecological estimand.",
  "figure_manifest": "figures/figure_manifest.json",
  "results_table_manifest": "manuscript/result_tables/result_table_manifest.json",
