      "result": "figure_1_roles.svg",
      "result_path": "figures/output/figure_1_roles.svg"
    },
    {
      "id": "F2",
      "label": "Figure 2 A-Islands",
      "source": "three frozen A-Islands artifacts",
      "transform": "build_figure_2_aislands.py",
      "result": "figure_2_aislands.svg + sidecars",
      "result_path": "figures/output/figure_2_aislands.svg"
    },
    {
      "id": "F3",
      "label": "Figure 3 Tanzania",
      "source": "frozen held-out benchmark + result fingerprint",
      "transform": "build_figure_3_tanzania.py",
      "result": "figure_3_tanzania.svg + sidecars",
      "result_path": "figures/output/figure_3_tanzania.svg"
    },
    {
      "id": "F4",
      "label": "Figure 4 boundary matrix",
      "source": "frozen A-Islands + Tanzania projections",
      "transform": "build_figure_4_boundary.py",
      "result": "figure_4_boundary.svg",
      "result_path": "figures/output/figure_4_boundary.svg"
    },
    {
      "id": "T3",
      "label": "Table 3 + Table S1",
