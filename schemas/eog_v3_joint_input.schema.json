{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zuizui0223/eog/schemas/eog_v3_joint_input.schema.json",
  "title": "EOG v3 joint-world input",
  "type": "object",
  "required": [
    "ecological_worlds",
    "observation_worlds"
  ],
  "properties": {
    "ecological_worlds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "world_id",
          "state_by_target"
        ],
        "properties": {
          "world_id": {
            "type": "string",
            "minLength": 1
          },
          "state_by_target": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    },
    "observation_worlds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "world_id",
          "supports"
        ],
        "properties": {
          "world_id": {
            "type": "string",
            "minLength": 1
          },
          "supports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "channel_id",
                "ecological_state",
                "possible_outcomes"
              ],
              "properties": {
                "channel_id": {
                  "type": "string",
                  "minLength": 1
                },
                "ecological_state": {
                  "type": "string",
                  "minLength": 1
                },
                "possible_outcomes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target_id",
          "channel_id",
          "observed_outcome"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "observed_outcome": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "action_supports": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    }
  },
  "additionalProperties": false
}
