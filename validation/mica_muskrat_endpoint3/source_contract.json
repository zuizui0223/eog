    "archive_media_types": [
      "application/zip",
      "application/octet-stream",
      "application/x-zip-compressed"
    ]
  },
  "transport_firewall": {
    "head_first": true,
    "head_response_body_bytes_allowed": 0,
    "require_positive_content_length": true,
    "range_accept_encoding": "identity",
    "require_http_206_for_every_range": true,
    "http_200_range_fallback": "terminal_pre_response_source_transport_stop_without_reading_body",
    "zip_gate": "classic ZIP only; zero-comment EOCD, no ZIP64, no multi-disk, no encrypted members",
    "full_archive_download_forbidden": true,
    "member_payload_reads_gate0": 0,
    "response_member_header_reads_gate0": 0
  },
  "frozen_member_identity_rules": {
    "deployment_member": {
      "exact_unique_basename": "deployments.csv",
      "required_count": 1
    },
    "observation_member": {
      "exact_unique_basename": "observations.csv",
      "required_count": 1,
      "payload_forbidden_before_full_endpoint_freeze": true
    },
    "media_member": {
      "exact_unique_basename": "media.csv",
      "required_count": 1,
      "payload_forbidden_before_full_endpoint_freeze": true
    },
    "datapackage_member": {
      "exact_unique_basename": "datapackage.json",
      "required_count": 1,
      "payload_forbidden_gate0": true
    },
    "case_sensitive": true,
    "no_post_gate_alias_or_member_renaming": true
  },
  "candidate_preflight": {
    "minimum_nodes": 20,
    "minimum_outer_units": 8,
    "minimum_repeated_nodes": 15,
    "require_separate_geometry_and_response": true,
    "require_coordinate_geometry": true,
    "require_closed_analysis_registry": true
  },
  "deployment_gate_frozen_before_deployment_bytes": {
    "analysis_node": "locationID",
    "required_exact_canonical_fields": [
      "deploymentID",
      "locationID",
      "latitude",
      "longitude",
      "deploymentStart",
      "deploymentEnd"
    ],
    "field_alias_repair_after_open": false,
    "coordinate_stability_tolerance_m_within_location": 10.0,
    "active_location_week_rule": "union deployment intervals by locationID and ISO week; eligible when overlap >=96 hours (4 camera-days); overlapping deployments do not double-count effort",
    "calendar_split": {
      "calibration": "ISO week start < 2022-01-01",
      "heldout": "ISO week start >= 2022-01-01"
    },
    "minimum_active_nodes_per_heldout_week": 15,
    "minimum_heldout_outer_weeks": 8,
    "minimum_repeated_nodes_spanning_calibration_and_heldout": 15,
    "minimum_total_analysis_nodes": 20,
    "minimum_distinct_response_blind_structural_scales": 3,
    "response_derived_node_filtering": false
  },
  "gate0_outputs_allowed": [
    "HEAD status/final URL/content length/content type/ETag/Last-Modified metadata",
    "bounded Range request ledger",
    "ZIP EOCD and central-directory fingerprint",
    "member names, methods, CRCs, compressed/uncompressed sizes and offsets",
    "unique frozen member identities"
  ],
  "gate0_outputs_forbidden": [
    "any ZIP member payload bytes",
    "deployment CSV rows",
    "observations/media/datapackage payload or header bytes",
    "muskrat response counts or prevalence",
    "model fits or heldout scores"
  ],
  "post_stop_retuning": false
