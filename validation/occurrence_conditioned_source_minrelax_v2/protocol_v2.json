  "theory_contract": {
    "individual_feasible": "F_s={theta>=theta0: all positives reachable from fixed s within H directed hops}",
    "possible": "F_exists=union_{s in alternatives} F_s",
    "source_robust": "F_all=intersection_{s in alternatives} F_s",
    "minimal_frontiers": "P_exists=ParetoMin(union_s P_s); P_all=ParetoMin({coordinatewise_max(p_s for s) : p_s in P_s for each s})",
    "proof_scope": "finite complete breakpoint grid with axiswise monotone edge permissions; same units, graph, positive set and horizon; source candidates are not conditioned on observed outcomes",
    "note": "ParetoMin(intersection P_s) is not P_all in general. Empty F_all is not absolute biological impossibility.",
