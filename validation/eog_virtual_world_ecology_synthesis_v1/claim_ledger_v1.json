  "admissible_claims": [
    {
      "id": "A",
      "claim": "Within v18's fixed 384 synthetic landscapes, dispersed source placement increased union coverage while clustered placement increased overlap and worst-source-loss insurance.",
      "status": "supported_in_frozen_generator",
      "evidence": [
        "v18"
      ],
      "not": "General law of metapopulation resilience or viability."
    },
    {
      "id": "B",
      "claim": "Restoring the original source count did not guarantee returning to original geographic coverage in v20's fixed turnover protocol.",
      "status": "supported_in_frozen_generator",
      "evidence": [
        "v20"
      ],
      "not": "Field recolonization probability, reproductive output or population persistence."
    },
    {
      "id": "C",
      "claim": "Source basin confluence produced more ambiguous static source provenance for clustered placement; the history-identification rate was higher for dispersed placement in the v22 observation library.",
      "status": "supported_in_related_synthetic_panels",
      "evidence": [
        "v19",
        "v21",
        "v22"
      ],
      "not": "One preregistered three-way coverage-insurance-observability mediation test or a universal detection phenomenon."
    },
    {
      "id": "D",
      "claim": "Identical static occupied-node maps can hide distinct directed relations and different single-node removal responses.",
      "status": "constructive_and_randomized_known_truth",
      "evidence": [
        "v10",
        "v12"
      ],
      "not": "A new theorem about ecological network redundancy, or empirical superiority over established connectivity models."
    },
    {
      "id": "E",
