    "adverse_complementary_added_value": {
      "paper_boundary": "structural_diagnostic_plus_context_dependent_predictive_complement",
      "allowed_claim": "Layer A remains a structural falsification framework; Layer B predictive value is not uniformly beneficial"
    },
    "pre_response_or_non_estimable_stop": {
      "counts_as_predictive_replication": false,
      "paper_role": "protocol_integrity_and_candidate_flow_only"
    }
  },
  "manuscript_reporting_rules": {
    "report_all_fresh_terminal_endpoints": true,
    "report_all_pre_response_and_pre_row_stops_in_candidate_flow": true,
    "stops_are_not_negative_layer_b_results": true,
    "primary_metric": "binary_log_loss",
    "show_each_heldout_unit_pair_when_available": true,
    "state_observation_process_and_ecosystem_for_each_endpoint": true,
    "separate_structural_falsification_from_predictive_complementarity": true,
    "do_not_infer_mechanistic_truth_from_predictive_gain": true
